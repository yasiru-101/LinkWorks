{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "*": [
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../Yasiru/**/*.ts",
    "../Yasiru/**/*.tsx",
    "../Pasindu/**/*.ts",
    "../Pasindu/**/*.tsx",
    "../Thimanya/**/*.ts",
    "../Thimanya/**/*.tsx",
    "../Chanuli/**/*.ts",
    "../Chanuli/**/*.tsx",
    "../Bhashitha/**/*.ts",
    "../Bhashitha/**/*.tsx"
  ]
}
