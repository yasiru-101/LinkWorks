rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfile() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.city is string
          && request.resource.data.city.size() > 0
          && request.resource.data.phone == request.auth.token.phone_number
          && request.resource.data.isClient is bool
          && request.resource.data.isWorker is bool
          && (request.resource.data.isClient || request.resource.data.isWorker);
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner()
        && validProfile()
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'city', 'isClient', 'isWorker', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner()
        && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'city', 'isClient', 'isWorker', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
